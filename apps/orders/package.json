{
  "name": "@booking/orders",
  "scripts": {
    "drizzle-kit:generate-dev": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "drizzle-kit:migrate-dev": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "drizzle-kit:migrate-test": "drizzle-kit migrate --config=./src/db/drizzle-test.config.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun run --env-file=.env.test vitest",
    "test:run": "bun run --env-file=.env.test vitest run"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "dependencies": {
    "@booking/common": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^20.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "uuid": "^13.0.2",
    "vitest": "^4.1.10"
  }
}
